+#[test]
+fn prepared_reflow_preserves_old_damage_and_matches_a_full_frame() {
+    let panel = || {
+        let mut app = App::headless(128, 48);
+        app.with_default_widgets();
+        let root = app.spawn_root().bg_color(Color::rgb(24, 48, 72)).id();
+        let state = app.add_model(Reading { value: 7 });
+        let reading = state.share();
+        app.compose(root, |cx| {
+            crate::ui! {
+                Row () {
+                    Text (text: ${ format_args!("{}", reading.value()) }, text_capacity: 5)
+                    Text ("sibling", id: "moving-sibling")
+                }
+            }
+        });
+        app.render_dirty().unwrap();
+        (app, state)
+    };
+    let (mut partial, partial_state) = panel();
+    let (mut full, full_state) = panel();
+    let sibling = partial.world.find_by_id("moving-sibling").unwrap();
+    let initial_x = partial.world.get::<ComputedRect>(sibling).unwrap().0.x;
+    for value in [12345, 1, 999, 0] {
+        partial_state.set(value);
+        full_state.set(value);
+        partial.prepare_layout().unwrap();
+        let sibling_x = partial.world.get::<ComputedRect>(sibling).unwrap().0.x;
+        if value > 9 {
+            assert!(sibling_x > initial_x);
+        } else {
+            assert_eq!(sibling_x, initial_x);
+        }
+        partial.prepare_layout().unwrap();
+        partial.render_dirty().unwrap();
+        full.render().unwrap();
+        let partial_pixels = partial.backend.framebuffer();
+        let full_pixels = full.backend.framebuffer();
+        let first_difference = partial_pixels
+            .buf
+            .as_slice()
+            .iter()
+            .zip(full_pixels.buf.as_slice())
+            .position(|(left, right)| left != right);
+        assert!(
+            first_difference.is_none(),
+            "reflow value {value}: first differing byte {first_difference:?}"
+        );
+    }
+}
