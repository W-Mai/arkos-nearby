+    let state = app.add_model(Reading { value: 7 });
+    let reading = state.share();
+    let runs = Rc::new(Cell::new(0));
+    let retained = runs.clone();
+    let text = app.compose(root, |cx| {
+        crate::ui! {
+            Text (
+                id: "page-label",
+                text: ${ { retained.set(retained.get() + 1); reading.value().to_string() } }
+            )
+        }
+    });
