+#[test]
+fn prepare_layout_updates_reactive_text_without_painting_or_consuming_damage() {
+    let flushes = Rc::new(Cell::new(0));
+    let output_flushes = flushes.clone();
+    let backend = crate::surface::framebuf::FramebufSurface::new(128, 48, move |_, _| {
+        output_flushes.set(output_flushes.get() + 1);
+    });
+    let mut app = App::new(backend);
+    let hooks = Rc::new(Cell::new(0));
+    app.with_default_widgets()
+        .add_plugin(CountRender(hooks.clone()));
+    let root = app.spawn_root().id();
+    let state = app.add_model(Reading { value: 7 });
+    let reading = state.share();
+    let text = app.compose(root, |cx| {
+        crate::ui! {
+            Text (text: ${ format_args!("{}", reading.value()) }, text_capacity: 5)
+        }
+    });
+    app.render_dirty().unwrap();
+    let first_width = app.world.get::<ComputedRect>(text).unwrap().0.w;
+    let pixels = app.backend.framebuffer().buf.as_slice().to_vec();
+    let initial_flushes = flushes.get();
+    let initial_hooks = hooks.get();
+    let damage = Rect::new(1, 1, 2, 3);
+    app.invalidate_rect(damage);
+    state.set(12345);
+
+    app.prepare_layout().unwrap();
+
+    assert_eq!(
+        app.world.get::<Text>(text).unwrap().resolve(&app.world),
+        "12345"
+    );
+    assert!(app.world.get::<ComputedRect>(text).unwrap().0.w > first_width);
+    assert!(app.world.has::<Dirty>(text));
+    assert!(
+        !app.world
+            .resource::<ExactDirtyRegions>()
+            .unwrap()
+            .is_empty()
+    );
+    assert_eq!(app.backend.framebuffer().buf.as_slice(), pixels);
+    assert_eq!(flushes.get(), initial_flushes);
+    assert_eq!(hooks.get(), initial_hooks);
+    app.render_dirty().unwrap();
+    assert!(flushes.get() > initial_flushes);
+    assert_eq!(hooks.get(), initial_hooks + 1);
+    assert_ne!(app.backend.framebuffer().buf.as_slice(), pixels);
+}
