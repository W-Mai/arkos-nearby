+    let calls = runs.get();
+    let pixels = app.backend.framebuffer().buf.as_slice().to_vec();
+    app.world.resource_mut::<FocusState>().unwrap().focused = Some(text);
+    let gestures = app.world.resource_mut::<GestureSystem>().unwrap();
+    gestures.recognizer.update(
+        &InputEvent::PointerDown {
+            id: 0,
+            x: crate::types::Fixed::ONE,
+            y: crate::types::Fixed::ONE,
