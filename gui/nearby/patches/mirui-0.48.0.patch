+struct CountRender(Rc<Cell<usize>>);
+
+impl<B: Surface, F: RendererFactory<B>> Plugin<B, F> for CountRender {
+    fn build(&mut self, _: &mut App<B, F>) {}
+    fn pre_render(&mut self, _: &mut World) {
+        self.0.set(self.0.get() + 1);
+    }
+}
